<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Automatic Formula Calculator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen transition-colors duration-200 selection:bg-indigo-500 selection:text-white">

    <!-- Toast Notification Banner -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-slate-900 dark:bg-slate-800 text-white px-4 py-3 rounded-xl shadow-lg border border-slate-700/60 flex items-center gap-2.5 text-sm font-medium">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span id="toastMessage">Copied to clipboard</span>
        </div>
    </div>

    <!-- Main Container -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        
        <!-- Header -->
        <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-8 border-b border-slate-200 dark:border-slate-800">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 text-xs font-semibold tracking-wide uppercase mb-2 border border-indigo-200/60 dark:border-indigo-800/60">
                    <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                    Real-Time Engine
                </div>
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                    Chained Formula Calculator
                </h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base mt-1">
                    Instant dependent calculation pipeline for variables <span class="font-mono font-semibold text-slate-700 dark:text-slate-300">A</span>, <span class="font-mono font-semibold text-slate-700 dark:text-slate-300">B</span>, and <span class="font-mono font-semibold text-slate-700 dark:text-slate-300">G</span>.
                </p>
            </div>

            <!-- Theme Toggle & Formula Reference Pill -->
            <div class="flex items-center gap-3 self-start sm:self-center">
                <button id="themeToggle" type="button" aria-label="Toggle Dark Mode" class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm">
                    <!-- Sun Icon (shown in dark mode) -->
                    <svg id="sunIcon" class="w-5 h-5 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                    <!-- Moon Icon (shown in light mode) -->
                    <svg id="moonIcon" class="w-5 h-5 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Input Variables Section -->
        <section class="mt-8 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Input Variables</h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Modify A, B, or G below — all dependent outputs update immediately.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2.5">
                    <button id="resetBtn" type="button" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Reset Default
                    </button>
                    <button id="clearBtn" type="button" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/50 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200/60 dark:border-rose-800/50 transition-colors">
                        Clear
                    </button>
                    <button id="saveBtn" type="button" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white shadow-sm shadow-indigo-500/20 transition-all flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                        </svg>
                        Save Calculation
                    </button>
                </div>
            </div>

            <!-- Inputs Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Variable A -->
                <div class="relative">
                    <label for="inputA" class="flex items-center justify-between text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        <span class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 font-mono font-bold text-xs flex items-center justify-center">A</span>
                            Variable A
                        </span>
                        <span class="text-xs text-slate-400 font-mono">e.g. 100</span>
                    </label>
                    <input type="number" step="any" id="inputA" value="100" placeholder="e.g. 100"
                        class="w-full px-4 py-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white font-mono text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <!-- Variable B -->
                <div class="relative">
                    <label for="inputB" class="flex items-center justify-between text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        <span class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 font-mono font-bold text-xs flex items-center justify-center">B</span>
                            Variable B
                        </span>
                        <span class="text-xs text-slate-400 font-mono">Non-zero (e.g. 5)</span>
                    </label>
                    <input type="number" step="any" id="inputB" value="5" placeholder="e.g. 5"
                        class="w-full px-4 py-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white font-mono text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <!-- Variable G -->
                <div class="relative">
                    <label for="inputG" class="flex items-center justify-between text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        <span class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 font-mono font-bold text-xs flex items-center justify-center">G</span>
                            Variable G
                        </span>
                        <span class="text-xs text-slate-400 font-mono">e.g. 12</span>
                    </label>
                    <input type="number" step="any" id="inputG" value="12" placeholder="e.g. 12"
                        class="w-full px-4 py-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white font-mono text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>
            </div>

            <!-- Alert Message for Edge Cases -->
            <div id="warningBanner" class="hidden mt-5 p-3.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 text-amber-800 dark:text-amber-300 text-sm flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <span id="warningText">Division by zero detected.</span>
            </div>
        </section>

        <!-- Calculated Results Grid (C, D, E, F) -->
        <section class="mt-8">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Calculated Pipeline</h2>
                <button id="copyAllBtn" type="button" class="text-xs sm:text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-950/50 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    Copy All Results
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                
                <!-- Card C: C = A / B -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-950/70 text-blue-600 dark:text-blue-400 font-mono font-bold text-sm flex items-center justify-center border border-blue-200/60 dark:border-blue-800/60">C</span>
                                <div>
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">Step 1</span>
                                    <span class="font-mono text-sm font-medium text-slate-700 dark:text-slate-300">C = A / B</span>
                                </div>
                            </div>
                            <button onclick="copyResult('C')" title="Copy C value" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                            </button>
                        </div>
                        <div id="valC" title="20" class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-white tracking-tight my-2 break-all cursor-help">
                            20
                        </div>
                    </div>
                    <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/80">
                        <p id="stepC" class="text-xs sm:text-sm font-mono text-slate-500 dark:text-slate-400 break-all">
                            100 / 5 = 20
                        </p>
                    </div>
                </div>

                <!-- Card D: D = C - 10.51 -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 font-mono font-bold text-sm flex items-center justify-center border border-emerald-200/60 dark:border-emerald-800/60">D</span>
                                <div>
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">Step 2</span>
                                    <span class="font-mono text-sm font-medium text-slate-700 dark:text-slate-300">D = C - 10.51</span>
                                </div>
                            </div>
                            <button onclick="copyResult('D')" title="Copy D value" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                            </button>
                        </div>
                        <div id="valD" title="9.49" class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-white tracking-tight my-2 break-all cursor-help">
                            9.49
                        </div>
                    </div>
                    <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/80">
                        <p id="stepD" class="text-xs sm:text-sm font-mono text-slate-500 dark:text-slate-400 break-all">
                            20 - 10.51 = 9.49
                        </p>
                    </div>
                </div>

                <!-- Card E: E = D * 52.838 -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/70 text-amber-600 dark:text-amber-400 font-mono font-bold text-sm flex items-center justify-center border border-amber-200/60 dark:border-amber-800/60">E</span>
                                <div>
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">Step 3</span>
                                    <span class="font-mono text-sm font-medium text-slate-700 dark:text-slate-300">E = D * 52.838</span>
                                </div>
                            </div>
                            <button onclick="copyResult('E')" title="Copy E value" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                            </button>
                        </div>
                        <div id="valE" title="501.4326" class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-white tracking-tight my-2 break-all cursor-help">
                            501.4326
                        </div>
                    </div>
                    <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/80">
                        <p id="stepE" class="text-xs sm:text-sm font-mono text-slate-500 dark:text-slate-400 break-all">
                            9.49 * 52.838 = 501.4326
                        </p>
                    </div>
                </div>

                <!-- Card F: F = E / C -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="w-8 h-8 rounded-xl bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 font-mono font-bold text-sm flex items-center justify-center border border-purple-200/60 dark:border-purple-800/60">F</span>
                                <div>
                                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">Step 4</span>
                                    <span class="font-mono text-sm font-medium text-slate-700 dark:text-slate-300">F = E / C</span>
                                </div>
                            </div>
                            <button onclick="copyResult('F')" title="Copy F full precision value" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                            </button>
                        </div>
                        <div id="valF" title="25.07163" class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-white tracking-tight my-2 break-all cursor-help">
                            25.0716
                        </div>
                    </div>
                    <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/80">
                        <p id="stepF" class="text-xs sm:text-sm font-mono text-slate-500 dark:text-slate-400 break-all">
                            501.4326 / 20 = 25.0716
                        </p>
                    </div>
                </div>

                <!-- Card H: H = (F * A * G) / 24 -->
                <div class="sm:col-span-2 bg-white dark:bg-slate-900 rounded-2xl border-2 border-indigo-200 dark:border-indigo-800/80 p-6 sm:p-7 shadow-md ring-1 ring-indigo-500/10 hover:border-indigo-400 dark:hover:border-indigo-600 transition-all flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute top-0 right-0 px-3 py-1 bg-indigo-600 text-white text-[10px] font-bold uppercase tracking-wider rounded-bl-xl">
                        Final Result
                    </div>
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="w-9 h-9 rounded-xl bg-indigo-600 text-white font-mono font-bold text-base flex items-center justify-center shadow-sm">H</span>
                                <div>
                                    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 block">Step 5</span>
                                    <span class="font-mono text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200">H = (F * A * G) / 24</span>
                                </div>
                            </div>
                            <button onclick="copyResult('H')" title="Copy H full precision value" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors mt-3 sm:mt-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                            </button>
                        </div>
                        <div id="valH" title="1253.5815" class="text-3xl sm:text-4xl font-bold font-mono text-indigo-600 dark:text-indigo-400 tracking-tight my-2 break-all cursor-help">
                            1,253.5815
                        </div>
                    </div>
                    <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <p id="stepH" class="text-xs sm:text-sm font-mono text-slate-500 dark:text-slate-400 break-all">
                            (25.0716 * 100 * 12) / 24 = 1253.5815
                        </p>
                        <span class="text-[11px] text-slate-400">Hover value for full precision</span>
                    </div>
                </div>

            </div>
        </section>

        <!-- Saved Calculations History Log -->
        <section class="mt-10 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
                <div>
                    <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Saved Calculations</h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Snapshot history of your recorded formula runs.</p>
                </div>
                <div id="historyActions" class="hidden flex items-center gap-2">
                    <button id="exportCsvBtn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        Export CSV
                    </button>
                    <button id="clearHistoryBtn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-colors">
                        Clear Log
                    </button>
                </div>
            </div>

            <!-- Empty State -->
            <div id="emptyHistory" class="text-center py-8 px-4 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                <p class="text-sm text-slate-500 dark:text-slate-400">No calculations saved yet. Click <span class="font-semibold text-indigo-600 dark:text-indigo-400">"Save Calculation"</span> above to log a result.</p>
            </div>

            <!-- Responsive Table -->
            <div id="historyTableWrapper" class="hidden overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-800 text-xs font-semibold uppercase tracking-wider text-slate-400">
                            <th class="py-3 px-2.5">A</th>
                            <th class="py-3 px-2.5">B</th>
                            <th class="py-3 px-2.5">G</th>
                            <th class="py-3 px-2.5">C</th>
                            <th class="py-3 px-2.5">D</th>
                            <th class="py-3 px-2.5">E</th>
                            <th class="py-3 px-2.5">F</th>
                            <th class="py-3 px-2.5 text-indigo-500">H</th>
                            <th class="py-3 px-2.5 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="historyBody" class="divide-y divide-slate-100 dark:divide-slate-800/70 font-mono text-xs sm:text-sm">
                        <!-- Dynamic rows inserted here -->
                    </tbody>
                </table>
            </div>
        </section>

    </div>

    <!-- Application Logic -->
    <script>
        // State storage for current results and saved log
        let currentResults = {
            valid: false,
            A: null,
            B: null,
            G: null,
            C: null,
            D: null,
            E: null,
            F: null,
            H: null
        };

        let historyLog = [];

        // DOM Elements
        const inputA = document.getElementById('inputA');
        const inputB = document.getElementById('inputB');
        const inputG = document.getElementById('inputG');
        const valC = document.getElementById('valC');
        const valD = document.getElementById('valD');
        const valE = document.getElementById('valE');
        const valF = document.getElementById('valF');
        const valH = document.getElementById('valH');
        const stepC = document.getElementById('stepC');
        const stepD = document.getElementById('stepD');
        const stepE = document.getElementById('stepE');
        const stepF = document.getElementById('stepF');
        const stepH = document.getElementById('stepH');
        const warningBanner = document.getElementById('warningBanner');
        const warningText = document.getElementById('warningText');

        // Format helper: up to 4 decimal places without trailing unnecessary zeros
        function formatNumber(num) {
            if (num === null || num === undefined || !isFinite(num)) return '—';
            // Round to 4 decimal places cleanly
            const rounded = Math.round((num + Number.EPSILON) * 10000) / 10000;
            return rounded.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 4
            });
        }

        // Raw formatted string for steps without commas
        function formatRaw(num) {
            if (num === null || num === undefined || !isFinite(num)) return '—';
            return String(Math.round((num + Number.EPSILON) * 10000) / 10000);
        }

        // Core calculation pipeline
        function calculate() {
            const rawA = inputA.value.trim();
            const rawB = inputB.value.trim();
            const rawG = inputG.value.trim();

            warningBanner.classList.add('hidden');

            // Handle empty inputs
            if (rawA === '' || rawB === '' || rawG === '') {
                setInvalidState('Enter values for A, B, and G');
                return;
            }

            const A = parseFloat(rawA);
            const B = parseFloat(rawB);
            const G = parseFloat(rawG);

            if (isNaN(A) || isNaN(B) || isNaN(G)) {
                setInvalidState('Please enter valid numeric values');
                return;
            }

            // Edge Case 1: B === 0 (C = A / B divides by zero)
            if (B === 0) {
                warningText.textContent = 'Variable B cannot be 0 because C = A / B would divide by zero.';
                warningBanner.classList.remove('hidden');

                valC.textContent = 'Cannot divide by 0';
                valC.title = 'Undefined (Division by 0)';
                valC.classList.add('text-rose-500', 'text-lg', 'sm:text-xl');
                valC.classList.remove('text-2xl', 'sm:text-3xl');
                stepC.textContent = `${formatRaw(A)} / 0 = Undefined`;

                [valD, valE, valF].forEach(el => {
                    el.textContent = '—';
                    el.title = '';
                    el.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
                    el.classList.add('text-2xl', 'sm:text-3xl');
                });
                valH.textContent = '—';
                valH.title = '';
                valH.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
                valH.classList.add('text-3xl', 'sm:text-4xl', 'text-indigo-600', 'dark:text-indigo-400');

                stepD.textContent = 'Waiting for valid C';
                stepE.textContent = 'Waiting for valid D';
                stepF.textContent = 'Waiting for valid E & C';
                stepH.textContent = 'Waiting for valid F';

                currentResults = { valid: false, A, B, G, C: null, D: null, E: null, F: null, H: null };
                return;
            }

            // Reset C styling if previously error
            valC.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
            valC.classList.add('text-2xl', 'sm:text-3xl');

            // Step 1: C = A / B
            const C = A / B;
            valC.textContent = formatNumber(C);
            valC.title = `Full precision: ${C}`;
            stepC.textContent = `${formatRaw(A)} / ${formatRaw(B)} = ${formatRaw(C)}`;

            // Step 2: D = C - 10.51
            const D = C - 10.51;
            valD.textContent = formatNumber(D);
            valD.title = `Full precision: ${D}`;
            stepD.textContent = `${formatRaw(C)} - 10.51 = ${formatRaw(D)}`;

            // Step 3: E = D * 52.838
            const E = D * 52.838;
            valE.textContent = formatNumber(E);
            valE.title = `Full precision: ${E}`;
            stepE.textContent = `${formatRaw(D)} * 52.838 = ${formatRaw(E)}`;

            // Step 4: F = E / C (Edge Case 2: C === 0 when A === 0)
            if (C === 0) {
                warningText.textContent = 'Since A is 0, C equals 0. Therefore, F = E / C cannot divide by zero.';
                warningBanner.classList.remove('hidden');

                valF.textContent = 'Cannot divide by 0';
                valF.title = 'Undefined (Division by 0)';
                valF.classList.add('text-rose-500', 'text-lg', 'sm:text-xl');
                valF.classList.remove('text-2xl', 'sm:text-3xl');
                stepF.textContent = `${formatRaw(E)} / 0 = Undefined`;

                valH.textContent = '—';
                valH.title = '';
                valH.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
                valH.classList.add('text-3xl', 'sm:text-4xl', 'text-indigo-600', 'dark:text-indigo-400');
                stepH.textContent = 'Waiting for valid F';

                currentResults = { valid: false, A, B, G, C, D, E, F: null, H: null };
                return;
            }

            // Restore F normal styling
            valF.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
            valF.classList.add('text-2xl', 'sm:text-3xl');

            const F = E / C;
            valF.textContent = formatNumber(F);
            valF.title = `Full precision: ${F}`;
            stepF.textContent = `${formatRaw(E)} / ${formatRaw(C)} = ${formatRaw(F)}`;

            // Step 5: H = (F * A * G) / 24
            const H = (F * A * G) / 24;
            valH.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
            valH.classList.add('text-3xl', 'sm:text-4xl', 'text-indigo-600', 'dark:text-indigo-400');
            valH.textContent = formatNumber(H);
            valH.title = `Full precision: ${H}`;
            stepH.textContent = `(${formatRaw(F)} * ${formatRaw(A)} * ${formatRaw(G)}) / 24 = ${formatRaw(H)}`;

            currentResults = { valid: true, A, B, G, C, D, E, F, H };
        }

        function setInvalidState(message) {
            [valC, valD, valE, valF].forEach(el => {
                el.textContent = '—';
                el.title = '';
                el.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
                el.classList.add('text-2xl', 'sm:text-3xl');
            });
            valH.textContent = '—';
            valH.title = '';
            valH.classList.remove('text-rose-500', 'text-lg', 'sm:text-xl');
            valH.classList.add('text-3xl', 'sm:text-4xl', 'text-indigo-600', 'dark:text-indigo-400');
            stepC.textContent = message;
            stepD.textContent = '—';
            stepE.textContent = '—';
            stepF.textContent = '—';
            stepH.textContent = '—';
            currentResults = { valid: false, A: null, B: null, G: null, C: null, D: null, E: null, F: null, H: null };
        }

        // Clipboard Copy Utility (using execCommand for iframe compatibility)
        function copyToClipboard(text, label) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast(label || `Copied: ${text}`);
            } catch (err) {
                showToast('Unable to copy to clipboard');
            }
            document.body.removeChild(textarea);
        }

        function copyResult(key) {
            const val = currentResults[key];
            if (val === null || val === undefined || !isFinite(val)) {
                showToast(`No valid value for ${key} to copy`);
                return;
            }
            const fullPrecision = String(val);
            copyToClipboard(fullPrecision, `Copied ${key} = ${fullPrecision}`);
        }

        // Toast Notification
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2400);
        }

        // Render History Log
        function renderHistory() {
            const emptyState = document.getElementById('emptyHistory');
            const tableWrapper = document.getElementById('historyTableWrapper');
            const historyActions = document.getElementById('historyActions');
            const tbody = document.getElementById('historyBody');

            if (historyLog.length === 0) {
                emptyState.classList.remove('hidden');
                tableWrapper.classList.add('hidden');
                historyActions.classList.add('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            tableWrapper.classList.remove('hidden');
            historyActions.classList.remove('hidden');

            tbody.innerHTML = historyLog.map((item, idx) => `
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                    <td class="py-3 px-2.5 text-slate-700 dark:text-slate-300">${formatRaw(item.A)}</td>
                    <td class="py-3 px-2.5 text-slate-700 dark:text-slate-300">${formatRaw(item.B)}</td>
                    <td class="py-3 px-2.5 text-slate-700 dark:text-slate-300">${formatRaw(item.G)}</td>
                    <td class="py-3 px-2.5 text-slate-600 dark:text-slate-400" title="${item.C}">${formatRaw(item.C)}</td>
                    <td class="py-3 px-2.5 text-slate-600 dark:text-slate-400" title="${item.D}">${formatRaw(item.D)}</td>
                    <td class="py-3 px-2.5 text-slate-600 dark:text-slate-400" title="${item.E}">${formatRaw(item.E)}</td>
                    <td class="py-3 px-2.5 text-slate-600 dark:text-slate-400" title="${item.F}">${formatRaw(item.F)}</td>
                    <td class="py-3 px-2.5 font-semibold text-indigo-600 dark:text-indigo-400" title="${item.H}">${formatRaw(item.H)}</td>
                    <td class="py-3 px-2.5 text-right whitespace-nowrap">
                        <button onclick="loadHistoryItem(${idx})" class="text-xs font-sans font-medium text-indigo-600 dark:text-indigo-400 hover:underline mr-2">Load</button>
                        <button onclick="deleteHistoryItem(${idx})" class="text-xs font-sans font-medium text-rose-500 hover:underline">Delete</button>
                    </td>
                </tr>
            `).join('');
        }

        function loadHistoryItem(index) {
            const item = historyLog[index];
            if (!item) return;
            inputA.value = item.A;
            inputB.value = item.B;
            inputG.value = item.G;
            calculate();
            showToast('Loaded inputs from history');
        }

        function deleteHistoryItem(index) {
            historyLog.splice(index, 1);
            renderHistory();
        }

        // Event Listeners
        inputA.addEventListener('input', calculate);
        inputB.addEventListener('input', calculate);
        inputG.addEventListener('input', calculate);

        document.getElementById('resetBtn').addEventListener('click', () => {
            inputA.value = '100';
            inputB.value = '5';
            inputG.value = '12';
            calculate();
            showToast('Reset to default values (A=100, B=5, G=12)');
        });

        document.getElementById('clearBtn').addEventListener('click', () => {
            inputA.value = '';
            inputB.value = '';
            inputG.value = '';
            calculate();
            inputA.focus();
        });

        document.getElementById('saveBtn').addEventListener('click', () => {
            if (!currentResults.valid) {
                showToast('Cannot save incomplete or invalid calculation');
                return;
            }
            historyLog.unshift({ ...currentResults });
            renderHistory();
            showToast('Calculation saved to log');
        });

        document.getElementById('copyAllBtn').addEventListener('click', () => {
            if (!currentResults.valid) {
                showToast('No complete calculation to copy');
                return;
            }
            const summary = `A = ${currentResults.A} | B = ${currentResults.B} | G = ${currentResults.G} | C = ${currentResults.C} | D = ${currentResults.D} | E = ${currentResults.E} | F = ${currentResults.F} | H = ${currentResults.H}`;
            copyToClipboard(summary, 'Copied full precision calculation summary');
        });

        document.getElementById('clearHistoryBtn').addEventListener('click', () => {
            historyLog = [];
            renderHistory();
            showToast('History cleared');
        });

        document.getElementById('exportCsvBtn').addEventListener('click', () => {
            if (historyLog.length === 0) return;
            const headers = ['A', 'B', 'G', 'C (A/B)', 'D (C-10.51)', 'E (D*52.838)', 'F (E/C)', 'H ((F*A*G)/24)'];
            const rows = historyLog.map(r => [r.A, r.B, r.G, r.C, r.D, r.E, r.F, r.H].join(','));
            const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows].join('\n');
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            link.setAttribute('download', 'formula_calculations.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('Exported CSV file');
        });

        // Theme Toggle Logic
        const themeToggle = document.getElementById('themeToggle');
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }
        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
        });

        // Initial calculation on load
        window.addEventListener('DOMContentLoaded', calculate);
    </script>
</body>
</html>